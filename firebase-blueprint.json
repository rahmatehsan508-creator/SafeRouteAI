{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document containing basic account info",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "User's display name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's registered email address",
          "maxLength": 150
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp of account creation"
        }
      },
      "required": ["email", "createdAt"]
    },
    "CommunityReport": {
      "title": "CommunityReport",
      "description": "Safety hazard or condition report submitted by a community member",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the reporting user",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "description": "Public name of contributor",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Category of hazard",
          "enum": [
            "Poor Lighting",
            "Road Damage",
            "Reported Incident",
            "Isolated Area",
            "Heavy Crowd",
            "Other"
          ]
        },
        "description": {
          "type": "string",
          "description": "Description of safety condition",
          "maxLength": 1000
        },
        "latitude": {
          "type": "number",
          "description": "Latitude coordinate of the report"
        },
        "longitude": {
          "type": "number",
          "description": "Longitude coordinate of the report"
        },
        "timestamp": {
          "type": "number",
          "description": "Epoch timestamp of report creation"
        },
        "status": {
          "type": "string",
          "description": "Verification status of report",
          "enum": ["Reported", "Under Review", "Community Confirmed", "Verified"]
        },
        "confirmations": {
          "type": "number",
          "description": "Count of peer confirmations"
        }
      },
      "required": [
        "userId",
        "category",
        "description",
        "latitude",
        "longitude",
        "timestamp",
        "status",
        "confirmations"
      ]
    },
    "SavedRoute": {
      "title": "SavedRoute",
      "description": "A bookmarked route saved by an authenticated user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID who saved this route",
          "maxLength": 128
        },
        "source": {
          "type": "string",
          "description": "Origin location text",
          "maxLength": 255
        },
        "destination": {
          "type": "string",
          "description": "Destination location text",
          "maxLength": 255
        },
        "sourceCoords": {
          "type": "object",
          "description": "Origin latitude and longitude"
        },
        "destCoords": {
          "type": "object",
          "description": "Destination latitude and longitude"
        },
        "travelMode": {
          "type": "string",
          "description": "Mode of travel used"
        },
        "routePreference": {
          "type": "string",
          "description": "Routing priority (fastest, balanced, safest)"
        },
        "distance": {
          "type": "string",
          "description": "Distance string (e.g. 4.2 km)"
        },
        "duration": {
          "type": "string",
          "description": "Duration string (e.g. 15 min)"
        },
        "safetyScore": {
          "type": "number",
          "description": "Estimated safety score from 0 to 100"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when route was saved"
        }
      },
      "required": [
        "userId",
        "source",
        "destination",
        "travelMode",
        "routePreference",
        "distance",
        "duration",
        "safetyScore",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile documents indexed by user UID"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/CommunityReport" },
      "description": "Community-reported hazards and conditions"
    },
    "/savedRoutes/{routeId}": {
      "schema": { "$ref": "#/entities/SavedRoute" },
      "description": "User saved routes accessible by the route owner"
    }
  }
}
